<% inverse ||= false %>
<% popover_id = dom_id(Array(target).last, :image) %>

<div class="image-controls">
	<button class="o-buttons o-buttons--ghost <%= if inverse then 'o-buttons--inverse' else 'o-buttons--mono' end %>" commandfor="<%= popover_id %>" command="show-modal">
		<i class="fa fa-image"></i>
		Banner&hellip;
	</button>
</div>

<dialog id="<%= popover_id %>" closedby="any">
	<button commandfor="<%= popover_id %>" command="close" class="o-buttons o-buttons--ghost o-buttons--mono o-buttons-icon o-buttons-icon--icon-only">
		<i class="fa fa-xmark"></i>
	</button>
	<h2>Banner image</h2>

	<%= form_with(model: target) do |form| %>
		<%= render 'images/form', image: image, form: form %>

		<%= form.submit class: 'o-buttons o-buttons--primary' %>
	<% end %>
</dialog>
