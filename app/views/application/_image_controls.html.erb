<% inverse ||= false %>
<% popover_id = dom_id(Array(target).last, :image_popover) %>

<div class="image-controls">
	<button class="o-buttons o-buttons--ghost <%= if inverse then 'o-buttons--inverse' else 'o-buttons--mono' end %>" commandfor="<%= popover_id %>" command="show-modal">
		<i class="fa fa-image"></i>
		Banner&hellip;
	</button>
</div>

<dialog id="<%= popover_id %>" closedby="any">
	<button commandfor="<%= popover_id %>" command="close" class="o-buttons o-buttons--ghost o-buttons--mono">
		<i class="fa fa-xmark"></i>
	</button>
	<h2>Banner image</h2>

	<%= render 'images/form', image: image, target: target, popover_id: popover_id %>
</dialog>
