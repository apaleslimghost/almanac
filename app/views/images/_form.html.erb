<% form = nil %>

<%= form_with(model: target, id: dom_id(Array(target).last, :image_form), html: { command: 'request-close', commandfor: popover_id }) { form = it } %>

<%= form.fields_for :image, image ||= Image.new(actable: UnsplashImage.new) do |f| %>
	<%= f.hidden_field :id, form: form.id %>
	<%= f.hidden_field :actable_type, form: form.id %>
	<%= f.fields_for :actable, image.specific do |a| %>
		<%= render 'unsplash_images/form', parent_form: form.id, field_name: a.field_name(:unsplash_id), results: [] %>
	<% end %>
<% end %>

<%= form.submit class: 'o-buttons o-buttons--primary', form: form.id %>
