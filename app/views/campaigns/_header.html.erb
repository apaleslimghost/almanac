<% content_for :header do %>
	<%= turbo_frame_tag @campaign do %>
		<h1>
			<% if @campaign.owner? current_user %>
				<%= form_with model: @campaign, data: { controller: 'autosave', action: 'input->autosave#save', autosave_target: 'form' }, class: 'inline-form' do |form| %>
					<%= form.text_field :name,
						class: 'inline-input autosize-input',
						data: {
							controller: 'auto-size-input',
							action: 'input->auto-size-input#update',
							turbo_permanent: true
						},
						placeholder: "Unnamed campaign…",
						autofocus: @campaign.name.blank?
					%>
				<% end %>
			<% else %>
				<%= @campaign.name %>
			<% end %>
		</h1>

		<% if @campaign.owner? current_user %>
			<%= form_with model: @campaign, data: { controller: 'autosave', action: 'input->autosave#save', autosave_target: 'form' } do |form| %>
				<%= form.text_field :tagline,
					class: 'inline-input autosize-input',
					data: {
						controller: 'auto-size-input',
						action: 'input->auto-size-input#update',
						turbo_permanent: true
					},
					placeholder: 'Tagline…'
				%>
			<% end %>
		<% else %>
			<% unless @campaign.tagline.blank? %>
				<p><%= @campaign.tagline %></p>
			<% end %>
		<% end %>
	<% end %>
<% end %>
