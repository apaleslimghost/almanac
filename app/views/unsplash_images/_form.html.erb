<%= turbo_frame_tag :unsplash_search do %>
	<%= form_with url: unsplash_images_search_path, method: :get, data: { turbo_stream: true } do |f| %>
		<div class="o-forms-field">
			<span class="o-forms-input o-forms-input--text o-forms-input--suffix">
				<%= hidden_field_tag :parent_form, parent_form %>
				<%= hidden_field_tag :field_name, field_name %>
				<%= f.search_field :q, value: @q, placeholder: "Search Unsplash…" %>
				<%= f.button class: "o-buttons o-buttons--primary" do %>
					<i class="fa fa-magnifying-glass"></i>
					Search
				<% end %>
			</span>
		</div>

		<div class="grid">
			<% results.each do |result| %>
				<label class="image-select">
					<input type="radio" name="<%= field_name %>" value="<%= result.unsplash_id %>" form="<%= parent_form %>">
					<%= render result %>
				</label>
			<% end %>
		</div>
	<% end %>
<% end %>
